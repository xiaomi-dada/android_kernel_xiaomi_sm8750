# Xiaomi 15 (dada) hardware.
#
# Only options the hardware actually needs. Xiaomi's own dada_perf.config also
# enabled MIUI instrumentation and device-identification code (MI_BOOT_TIME,
# MI_STACK, MI_UBT, MI_TRACE, PRINTK_ENHANCE, MI_BOOT_MONITOR, MI_RT_MONITOR,
# MI_POWER_SAVE, MIHW and the drivers/xiaomi collection). None of that is
# carried here: it drives no hardware.

# Consumer IR emitter, driven over SPI. dada's device tree has
#     ir-spi@0 { compatible = "ir-spi"; status = "ok"; }
# and the odm side ships consumerir.qcom.so with the consumerir feature XML.
#
# That HAL opens /dev/ir_spi, sets the burst length with an ioctl and writes
# the rendered bitmap, so it needs the character device Xiaomi's driver
# publishes, not the /dev/lirc0 that drivers/media/rc/ir-spi.c offers. The two
# claim the same compatible, so the rc-core one stays off.
CONFIG_IR_SPI_XIAOMI=m

# Fingerprint.
#
# dada is dual sourced: both fingerprint.goodix_us.default.so and
# fingerprint.qcom_us.default.so ship, along with libgf_hal.so. mi_fp owns the
# reset and power GPIOs, the intr2 line, the touch correlation UDFPS needs, and
# the sensor identity read from the "xiaomi,vendor_names" device tree property,
# which is what selects between the two sensor HALs.
#
# It overlaps Qualcomm's qbt_handler (qcom/opensource/fingerprint) heavily --
# fp_ultra.h even reuses the "qbt_ipc" and "qbt_fd" device names -- but
# qbt_handler covers only the QTI sensor, and both shipped HALs talk to
# /sys/class/xiaomi_fp/xiaomi-fp/device/fplive and never mention qbt. Replacing
# mi_fp would need an open fingerprint HAL, and there cannot be one: libgf_hal.so
# links libQSEEComAPI.so and matching happens inside a signed trusted
# application loaded from /vendor/firmware_mnt/image.
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_MI_FP=m

# The SMB client, which Xiaomi's own dada_perf.config enables and which
# userspace reaches through the storage manager.  It brings netfs, the DNS
# resolver upcall and the NLS and hashing helpers with it.
CONFIG_CIFS=m

# The Cirrus DSP firmware loader.  The CS35L43 amplifiers are driven by a
# codec module in the audio techpack, which is outside this tree and so cannot
# select it the way an in-tree codec would.
CONFIG_FW_CS_DSP=m

# Kernel TLS.  It is the one module the shipped system_dlkm carries that this
# tree could not build, and system_dlkm has to come from the same kernel as
# everything else.
CONFIG_TLS=m

# Board identification and driver event reporting, which the Xiaomi vendor
# modules call into.
CONFIG_MI_HARDWARE_ID=m
CONFIG_MI_EVENT=m

# The T1 GPIO control device.  dada's device tree has
#     mi_t1_chip { compatible = "mdm,mi_t1_chip"; gpio-count = <2>; }
# naming TLMM 201 and 172, which the driver drives low at probe and then
# exposes over /dev/modem_t1_gpio_ctrl.  Nothing this port ships opens that
# node, but the initial pin state is a hardware effect worth keeping.
CONFIG_MI_T1_CHIP=m

# The SAR detection line.  dada's device tree has
#     xiaomi_wifi_gpio { compatible = "xiaomi,xiaomi-wifi"; gpio = <&tlmm 79 0>; }
# and the driver reports its edges over a "sar_status" generic netlink family,
# which the WLAN side reads to pick a transmit power table.
CONFIG_MI_WIFI_GPIO=m

# The charging stack.  Xiaomi ships these as modules and publishes no source for
# them; drivers/power/supply/mca is what was recovered from the shipped ones.
#
# They form a closed set that resolves against itself -- mca_log is imported by
# forty of them, mca_sysfs by twenty-four, mca_event by twenty-two -- so it is
# all or nothing: a module built from source carries this kernel's symbol CRCs,
# which the prebuilt ones were not compiled against, and a partial replacement
# stops the rest from binding.  All of it is built from source now, so it is on.
#
# None of it has run on hardware.
CONFIG_XM_POWER_SUPPLY=m

# The ADSP owns charging on this board and the MCA stack talks to it directly.
# The QTI charger client, which sun_perf.config turns on, is a second client on
# the same PMIC Glink channel registering a second battery power supply, so it
# is turned back off here.
# CONFIG_QTI_BATTERY_CHARGER is not set
